{
  "version": 2,
  "rewrites": [
    {
      "source": "/embers",
      "destination": "/embers.html"
    },
    {
      "source": "/reveal",
      "destination": "/reveal.html"
    },
    {
      "source": "/test-reveal",
      "destination": "/test-reveal.html"
    },
    {
      "source": "/reveal-test",
      "destination": "/reveal-test.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/paper",
      "destination": "/paper.html"
    },
    {
      "source": "/expo",
      "destination": "/expo.html"
    },
    {
      "source": "/hackathon",
      "destination": "/hackathon.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "headers": [
    {
      "source": "/(admin|admin\\.html|embers|embers\\.html|api/.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, private"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
